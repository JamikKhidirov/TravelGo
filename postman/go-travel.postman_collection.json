    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Health versioned",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "Destinations",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/destinations?page=1&page_size=20"
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/destinations/search?q=city&min_rating=0&max_price=10000&page=1&page_size=20"
          }
        },
        {
          "name": "Top",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/destinations/top?limit=10"
          }
        },
        {
          "name": "Countries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/destinations/countries"
          }
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/destinations/{{destinationId}}"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/destinations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rome\",\n  \"country\": \"Italy\",\n  \"city\": \"Rome\",\n  \"description\": \"Eternal city\",\n  \"image_url\": \"https://example.com/rome.jpg\",\n  \"rating\": 4.8,\n  \"price_from\": 1200,\n  \"currency\": \"USD\"\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/destinations/{{destinationId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rome\",\n  \"country\": \"Italy\",\n  \"city\": \"Rome\",\n  \"description\": \"Eternal city updated\",\n  \"rating\": 4.9,\n  \"price_from\": 1300,\n  \"currency\": \"USD\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/destinations/{{destinationId}}"
