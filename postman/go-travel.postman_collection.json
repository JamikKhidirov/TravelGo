{
  "info": {
    "name": "GoTravel API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete GoTravel API collection: health, destinations, tours, events, sync, auth, cart, orders, payments, reviews, vouchers, admin, WebSocket."
